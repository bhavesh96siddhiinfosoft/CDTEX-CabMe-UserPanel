APP_NAME=CabMe
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# No database. This panel is an API client over cabme-admin — all business
# data lives in the cabme_admin database, reached via CABME_API_URL below.
# Sessions and cache use the file driver. If this panel is ever deployed on
# multiple servers, add a DB here for sessions/queue tables only.

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# CabMe admin API
# ---------------------------------------------------------------------------
# CABME_API_KEY must match the cabme-admin .env APP_KEY EXACTLY, including the
# "base64:" prefix — the admin's ApiKeyAuth middleware compares them verbatim.
CABME_API_URL=http://127.0.0.1:8124
CABME_API_KEY=
CABME_API_TIMEOUT=30
CABME_API_RETRIES=2
CABME_API_DEBUG=false

# Cached seconds for v1/settings/ (currency, map key, active services).
CABME_SETTINGS_TTL=60

# Live-tracking poll interval in milliseconds.
CABME_POLL_INTERVAL=5000

# Routing provider used when the admin is not configured for Google Maps.
OSRM_URL=https://router.project-osrm.org

# ---------------------------------------------------------------------------
# Web push (optional — "Enable ride alerts" stays hidden until all three are set)
# ---------------------------------------------------------------------------
# The SERVER half of Firebase (service-account JSON + sender id) is configured
# in the admin under Settings -> Notifications and reaches this panel through
# the API. Only the WEB APP half lives here, and all three values are public
# browser values — they are not secrets.
#
#   Firebase console -> Project settings -> General -> Your apps -> Web app
#       FIREBASE_API_KEY   ("apiKey")
#       FIREBASE_APP_ID    ("appId")
#   Firebase console -> Project settings -> Cloud Messaging -> Web Push certificates
#       FIREBASE_VAPID_KEY ("Key pair")
#
# The live host must also be listed under Authentication -> Settings ->
# Authorized domains, or the browser token request is rejected.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=
